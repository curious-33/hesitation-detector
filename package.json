{
	"name": "hesitation-detector-monorepo",
	"version": "0.2.0",
	"private": true,
	"description": "The Empathy Layer for Frontend Commerce - Monorepo",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev --workspace=packages/demo",
		"build": "npm run build --workspaces --if-present",
		"build:core": "npm run build --workspace=packages/core",
		"build:react": "npm run build --workspace=packages/react",
		"build:vue": "npm run build --workspace=packages/vue",
		"build:demo": "npm run build --workspace=packages/demo",
		"build:libs": "npm run build:core && npm run build:react && npm run build:vue",
		"postinstall": "npm run build:libs",
		"start": "npm run start --workspace=packages/demo",
		"clean": "rm -rf packages/*/dist packages/*/.next packages/*/node_modules node_modules"
	},
	"keywords": [
		"hesitation",
		"analytics",
		"conversion",
		"ux",
		"behavioral-tracking"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"typescript": "^5.3.3"
	}
}
